{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-electron/main",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true
  },
  "include": ["electron", "src/types/harness.ts"],
  "exclude": ["electron/preload.ts"]
}
