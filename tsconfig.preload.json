{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-electron",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "jsx": "preserve",
    "strict": true
  },
  "include": ["electron/preload.ts", "src/types/harness.ts"]
}
